{
  "$schema": "https://json.schemastore.org/staticwebapp.config.json",
  "navigationFallback": {
    "rewrite": "/index.html",
    "exclude": [
      "/assets/*",
      "/.*",
      "/*.{png,jpg,jpeg,gif,svg,ico,webp,woff,woff2,ttf,eot,json,xml,txt,wasm,mjs,pdf,env,key,pem,bak,ini,conf,sql}"
    ]
  },
  "routes": [
    {
      "route": "/.env*",
      "statusCode": 404
    },
    {
      "route": "/.git/*",
      "statusCode": 404
    },
    {
      "route": "/server.key",
      "statusCode": 404
    },
    {
      "route": "/*.key",
      "statusCode": 404
    },
    {
      "route": "/*.pem",
      "statusCode": 404
    },
    {
      "route": "/merge",
      "redirect": "/merge-pdf/",
      "statusCode": 301
    },
    {
      "route": "/split",
      "redirect": "/split-pdf/",
      "statusCode": 301
    },
    {
      "route": "/compress",
      "redirect": "/compress-pdf/",
      "statusCode": 301
    },
    {
      "route": "/pdf-analyzer",
      "redirect": "/analyze-pdf/",
      "statusCode": 301
    },
    {
      "route": "/analyze",
      "redirect": "/analyze-pdf/",
      "statusCode": 301
    },
    {
      "route": "/tools/pdf-analyzer",
      "redirect": "/analyze-pdf/",
      "statusCode": 301
    },
    {
      "route": "/pdf-editor",
      "redirect": "/edit-pdf/",
      "statusCode": 301
    },
    {
      "route": "/edit",
      "redirect": "/edit-pdf/",
      "statusCode": 301
    },
    {
      "route": "/qr-pdf-share",
      "redirect": "/pdf-to-qr-code/",
      "statusCode": 301
    },
    {
      "route": "/pdf-to-qr",
      "redirect": "/pdf-to-qr-code/",
      "statusCode": 301
    },
    {
      "route": "/extract-pages",
      "redirect": "/split-pdf/",
      "statusCode": 301
    },
    {
      "route": "/extract-pdf-pages",
      "redirect": "/split-pdf/",
      "statusCode": 301
    },
    {
      "route": "/organize",
      "redirect": "/organize-pdf/",
      "statusCode": 301
    },
    {
      "route": "/reorder-pages",
      "redirect": "/organize-pdf/",
      "statusCode": 301
    },
    {
      "route": "/rotate",
      "redirect": "/rotate-pdf/",
      "statusCode": 301
    },
    {
      "route": "/watermark",
      "redirect": "/watermark-pdf/",
      "statusCode": 301
    },
    {
      "route": "/delete-pages",
      "redirect": "/delete-pdf-pages/",
      "statusCode": 301
    },
    {
      "route": "/page-numbers",
      "redirect": "/add-page-numbers-to-pdf/",
      "statusCode": 301
    },
    {
      "route": "/add-page-numbers",
      "redirect": "/add-page-numbers-to-pdf/",
      "statusCode": 301
    },
    {
      "route": "/protect",
      "redirect": "/protect-pdf/",
      "statusCode": 301
    },
    {
      "route": "/unlock",
      "redirect": "/unlock-pdf/",
      "statusCode": 301
    },
    {
      "route": "/sign",
      "redirect": "/sign-pdf/",
      "statusCode": 301
    },
    {
      "route": "/redact",
      "redirect": "/redact-pdf/",
      "statusCode": 301
    },
    {
      "route": "/repair",
      "redirect": "/repair-pdf/",
      "statusCode": 301
    },
    {
      "route": "/ocr",
      "redirect": "/ocr-pdf/",
      "statusCode": 301
    },
    {
      "route": "/scan-pdf",
      "redirect": "/scan-to-pdf/",
      "statusCode": 301
    },
    {
      "route": "/scan-handwriting",
      "redirect": "/scan-handwriting-to-pdf/",
      "statusCode": 301
    },
    {
      "route": "/compare",
      "redirect": "/compare-pdf/",
      "statusCode": 301
    },
    {
      "route": "/pdf-to-images",
      "redirect": "/pdf-to-jpg/",
      "statusCode": 301
    },
    {
      "route": "/pdf-builder",
      "redirect": "/analyze-pdf/",
      "statusCode": 301
    },
    {
      "route": "/pdf-builder/",
      "redirect": "/analyze-pdf/",
      "statusCode": 301
    },
    {
      "route": "/split-pdf-pages",
      "redirect": "/split-pdf/",
      "statusCode": 301
    }
  ],
  "globalHeaders": {
    "Content-Security-Policy": "default-src 'self'; script-src 'self' 'unsafe-inline' 'wasm-unsafe-eval' https://pagead2.googlesyndication.com https://adservice.google.com https://tpc.googlesyndication.com https://www.googletagmanager.com https://*.clarity.ms https://scripts.clarity.ms; worker-src 'self' blob:; child-src 'self' blob:; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob: https: https://*.google-analytics.com https://*.googlesyndication.com https://*.doubleclick.net https://*.clarity.ms https://*.bing.com; font-src 'self' data:; connect-src 'self' blob: data: https://pdfbolt.in https://www.pdfbolt.in https://pdfbolt-api.onrender.com https://generativelanguage.googleapis.com https://*.google-analytics.com https://*.analytics.google.com https://*.googletagmanager.com https://pagead2.googlesyndication.com https://*.googlesyndication.com https://*.adtrafficquality.google https://googleads.g.doubleclick.net https://*.doubleclick.net https://*.google.com https://*.clarity.ms https://*.bing.com; frame-src 'self' https://googleads.g.doubleclick.net https://tpc.googlesyndication.com https://www.google.com https://pagead2.googlesyndication.com https://www.googletagmanager.com; object-src 'none'; base-uri 'self'; form-action 'self';",
    "Strict-Transport-Security": "max-age=31536000; includeSubDomains; preload",
    "Cross-Origin-Opener-Policy": "same-origin",
    "X-Content-Type-Options": "nosniff",
    "X-Frame-Options": "SAMEORIGIN",
    "Referrer-Policy": "strict-origin-when-cross-origin",
    "Permissions-Policy": "camera=(self), microphone=(), geolocation=()"
  },
  "mimeTypes": {
    ".wasm": "application/wasm",
    ".mjs": "text/javascript",
    ".json": "application/json"
  },
  "responseOverrides": {
    "404": {
      "rewrite": "/404.html",
      "statusCode": 404
    }
  }
}