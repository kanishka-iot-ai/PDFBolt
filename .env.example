# ==============================================================================
# PDFBolt Frontend Environment Configuration (.env.example)
# ==============================================================================

# Backend API URL (defaults to relative /api/v1 in production)
VITE_API_URL=https://api.pdfbolt.com

# Google AdSense Configuration
VITE_ADS_ENABLED=false
VITE_ADSENSE_CLIENT=ca-pub-XXXXXXXXXXXXXXXX
VITE_ADSENSE_TEST_MODE=false

# Optional individual AdSense Ad Slot IDs
VITE_ADSENSE_SLOT_HOME_CONTENT=
VITE_ADSENSE_SLOT_TOOL_CONTENT=
VITE_ADSENSE_SLOT_RESULT_BOTTOM=
VITE_ADSENSE_SLOT_GUIDE_CONTENT=
VITE_ADSENSE_SLOT_GUIDE_SIDEBAR=
VITE_ADSENSE_SLOT_ENCYCLOPEDIA=
VITE_ADSENSE_SLOT_CALCULATOR=
VITE_ADSENSE_SLOT_HUB=

# Optional EmailJS configuration for contact form
VITE_EMAILJS_SERVICE_ID=
VITE_EMAILJS_TEMPLATE_ID=
VITE_EMAILJS_PUBLIC_KEY=

# --- Server-Side Only / Local Proxy (NO VITE_ prefix = never bundled into client) ---
GEMINI_API_KEY=
