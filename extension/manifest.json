{
  "manifest_version": 3,
  "name": "PDFBolt – Fast & Private In-Browser PDF Tools",
  "version": "1.0.0",
  "description": "Merge, compress, split, convert, and edit PDFs locally in your browser with zero server uploads and 100% data privacy.",
  "homepage_url": "https://pdfbolt.in",
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "PDFBolt - Free & Private PDF Toolkit",
    "default_icon": {
      "16": "icons/icon-16.png",
      "32": "icons/icon-32.png",
      "48": "icons/icon-48.png",
      "128": "icons/icon-128.png"
    }
  }
}
