# ==============================================================================
# PDFBolt Backend Engine Configuration (backend/.env.example)
# ==============================================================================

# Environment & Server
APP_ENV=production
DEBUG=false
PORT=8000
HOST=0.0.0.0

# Security & CORS
API_SECRET_KEY=change-this-in-production-to-a-secure-random-token
CORS_ORIGINS=["https://pdfbolt.in","https://www.pdfbolt.in"]
MAX_UPLOAD_SIZE_BYTES=104857600
MAX_PAGE_LIMIT=1000

# Partner & B2B Collaboration API Keys
# When REQUIRE_API_KEY_FOR_EXTERNAL=true, all non-browser programmatic API calls must supply an API key.
# When false (default), first-party web app and local testing continue seamlessly.
REQUIRE_API_KEY_FOR_EXTERNAL=false
PARTNER_DEFAULT_RATE_LIMIT=120

# Partner Keys format (JSON dictionary with custom quotas and tiers):
# PARTNER_API_KEYS='{"partner_acme": {"key": "pdfbolt_live_partner_acme_xxxx", "tier": "enterprise", "rate_limit": 300}}'
# Or simple comma-separated keys:
# PARTNER_API_KEYS="pdfbolt_live_sample1,pdfbolt_live_sample2"
PARTNER_API_KEYS={}

# Storage & Temporary Document Retention Policy
STORAGE_BACKEND=gcs
LOCAL_STORAGE_DIR=./storage
PROCESSING_FILE_TTL_SECONDS=900
HARD_SAFETY_TTL_SECONDS=1200
CLEANUP_INTERVAL_SECONDS=300
SIGNED_URL_TTL_SECONDS=900

# Google Cloud Storage (GCS) Configuration (Placeholders)
GCP_PROJECT_ID=
GCS_BUCKET_NAME=
GCS_REGION=us-central1

# Google Cloud Pub/Sub Queue Configuration (Placeholders)
PUBSUB_TOPIC_JOBS=pdfbolt-jobs
PUBSUB_SUBSCRIPTION_JOBS=pdfbolt-jobs-sub

# Rate Limiting
RATE_LIMIT_PER_MINUTE=60
