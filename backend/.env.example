# ==============================================================================
# PDFBolt Backend Engine Configuration (backend/.env.example)
# ==============================================================================

# Environment & Server
APP_ENV=production
DEBUG=false
PORT=8000
HOST=0.0.0.0

# Security & CORS
API_SECRET_KEY=change-this-in-production-to-a-secure-random-token
CORS_ORIGINS=["https://pdfbolt.in","https://www.pdfbolt.in"]
MAX_UPLOAD_SIZE_BYTES=104857600
MAX_PAGE_LIMIT=1000

# Storage & Temporary Document Retention Policy
STORAGE_BACKEND=gcs
LOCAL_STORAGE_DIR=./storage
PROCESSING_FILE_TTL_SECONDS=900
HARD_SAFETY_TTL_SECONDS=1200
CLEANUP_INTERVAL_SECONDS=300
SIGNED_URL_TTL_SECONDS=900

# Google Cloud Storage (GCS) Configuration (Placeholders)
GCP_PROJECT_ID=
GCS_BUCKET_NAME=
GCS_REGION=us-central1

# Google Cloud Pub/Sub Queue Configuration (Placeholders)
PUBSUB_TOPIC_JOBS=pdfbolt-jobs
PUBSUB_SUBSCRIPTION_JOBS=pdfbolt-jobs-sub

# Rate Limiting
RATE_LIMIT_PER_MINUTE=60
