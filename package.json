{
  "name": "pdfbolt-pro",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build && python scripts/generate_prerender.py",
    "preview": "vite preview",
    "test": "vitest",
    "build:docker": "docker build -t pdfbolt-pro .",
    "docker:run": "docker run -d -p 80:80 --name pdfbolt pdfbolt-pro",
    "docker:stop": "docker stop pdfbolt && docker rm pdfbolt",
    "deploy:docker": "npm run build:docker && npm run docker:run",
    "clean": "rm -rf dist node_modules"
  },
  "dependencies": {
    "@emailjs/browser": "^4.4.1",
    "@google/genai": "^1.38.0",
    "docx": "^9.5.1",
    "dotenv": "^17.3.1",
    "exceljs": "^4.4.0",
    "file-saver": "^2.0.5",
    "html2canvas": "^1.4.1",
    "jspdf": "^4.1.0",
    "jszip": "^3.10.1",
    "lucide-react": "0.474.0",
    "mammoth": "^1.6.0",
    "pdf-lib": "1.17.1",
    "pdf-lib-plus-encrypt": "^1.1.0",
    "pdfjs-dist": "^4.0.379",
    "qrcode": "1.5.4",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-helmet-async": "^2.0.4",
    "react-router-dom": "^7.13.0",
    "save": "^2.9.0",
    "signature_pad": "^5.1.3",
    "tailwindcss-animate": "^1.0.7",
    "tesseract.js": "^5.0.0"
  },
  "devDependencies": {
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@types/file-saver": "^2.0.7",
    "@types/node": "^20.11.0",
    "@types/react": "^18.3.1",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^5.0.0",
    "autoprefixer": "^10.4.17",
    "jsdom": "^27.4.0",
    "postcss": "^8.4.35",
    "tailwindcss": "^3.4.1",
    "terser": "^5.46.0",
    "typescript": "~5.8.2",
    "vite": "^6.2.0",
    "vitest": "^4.0.18"
  },
  "overrides": {
    "uuid": "^11.1.1"
  }
}
